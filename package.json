{
  "name": "roundsong",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev:server": "node --watch server/index.ts",
    "dev:web": "astro dev",
    "dev": "concurrently -n server,web -c green,magenta \"pnpm dev:server\" \"pnpm dev:web\"",
    "build": "astro build",
    "start": "node server/index.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "check:evidence": "node scripts/check-evidence.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "astro": "7.3.6",
    "concurrently": "^10.0.5",
    "jsdom": "^30.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "pnpm": ">=11"
  },
  "dependencies": {
    "marked": "18.1.0",
    "ws": "8.22.0"
  }
}
