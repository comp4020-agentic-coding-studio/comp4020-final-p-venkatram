---
// Ambient background for pre-app pages (login, signup, rooms list) — just the
// photo, not index.astro's headline/carousel/CTA (homepage-specific
// marketing copy) or its sound-wave strip (landing-page-only decoration).
import { Image } from "astro:assets";
import heroImage from "../assets/sheet-music.jpg";
---

<div class="page-backdrop" aria-hidden="true">
  <Image
    src={heroImage}
    alt=""
    class="page-backdrop-image"
    widths={[480, 960, 1600, 2400]}
    sizes="100vw"
    loading="eager"
  />
</div>
