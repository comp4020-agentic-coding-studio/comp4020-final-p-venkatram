---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "A collaborative music-education platform for distance learning." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} · Roundsong</title>
    <script is:inline>
      // Applied before first paint so there's no flash of the wrong theme.
      try {
        var saved = localStorage.getItem("theme");
        if (saved === "dark" || saved === "light") {
          document.documentElement.setAttribute("data-theme", saved);
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <button type="button" class="hamburger-btn" id="site-nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
        <span class="hamburger-icon" aria-hidden="true"></span>
      </button>
      <a class="brand" href="/">Round<span class="brand-accent">song</span></a>
    </header>

    <div class="site-nav-backdrop" id="site-nav-backdrop"></div>
    <nav class="site-nav" id="site-nav" aria-label="Main menu" aria-hidden="true">
      <button type="button" class="site-nav-close" id="site-nav-close" aria-label="Close menu">&times;</button>
      <a href="/rooms/">Rooms</a>
      <a href="/activity/">Activity</a>
      <span id="auth-nav"></span>
      <button type="button" class="theme-toggle" data-theme-toggle>Switch to dark</button>
      <div id="room-nav-section" class="site-nav-section" hidden>
        <hr class="site-nav-divider" />
        <p class="site-nav-heading">This room</p>
        <button type="button" class="room-nav-btn" data-panel="collab" aria-selected="true">Collaboration Room</button>
        <button type="button" class="room-nav-btn" data-panel="record" aria-selected="false">Recording</button>
        <button type="button" class="room-nav-btn" data-panel="compose" aria-selected="false">Composition Space</button>
      </div>
    </nav>

    <main class="shell">
      <slot />
    </main>
    <script>
      import { initThemeToggle } from "../lib/theme";
      import { renderAuthNav } from "../lib/session";
      import { initSiteNav } from "../lib/site-nav";
      initThemeToggle();
      initSiteNav();
      void renderAuthNav();
    </script>
  </body>
</html>
