---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import heroImage from "../assets/sheet-music.jpg";
---

<Layout title="Home" description="WaveForge: a collaborative music-education platform for distance learning.">
  <section class="hero">
    <Image
      src={heroImage}
      alt="Close-up of an annotated sheet music book, open to a piano piece with handwritten performance notes"
      class="hero-image"
      widths={[480, 960, 1600, 2400]}
      sizes="100vw"
      loading="eager"
    />
    <div class="hero-overlay">
      <h1>Distance shouldn't mean nobody sings together.</h1>

      <div class="hero-fade-stage">
        <div class="hero-slide is-active" data-slide="why">
          <p>
            Real internet latency makes playing in perfect sync impossible over distance — no app changes that.
            WaveForge doesn't pretend otherwise: it's built for call-and-response, the way a singing lesson or a
            round already works.
          </p>
        </div>

        <div class="hero-slide" data-slide="how">
          <h2>How it works</h2>
          <ul>
            <li>One person leads — a phrase, a line, a verse — the room answers in turn.</li>
            <li>Camera and mic only turn on when you say so, every time you join.</li>
            <li>"Original Sound" is raw when you ask for it — no processing fighting two people singing together.</li>
          </ul>
        </div>

        <div class="hero-slide" data-slide="what">
          <h2>What's here</h2>
          <ul>
            <li>Rooms you create or join by link, camera by consent.</li>
            <li>Lyrics with a karaoke-style cursor, and a shared staff-notation composition space.</li>
            <li>Personal and group recordings, saved straight to your device.</li>
          </ul>
        </div>
      </div>

      <div class="hero-cta">
        <a class="btn" href="/signup/">Create an account</a>
        <a class="btn secondary" href="/login/">Log in</a>
      </div>
    </div>
  </section>

  <section class="stats-strip" id="stats-strip" aria-label="Your WaveForge activity" hidden>
    <div class="stat">
      <span class="stat-number" id="stat-rooms">0</span>
      <span class="stat-label">rooms created</span>
    </div>
    <div class="stat">
      <span class="stat-number" id="stat-notes">0</span>
      <span class="stat-label">notes composed</span>
    </div>
    <div class="stat">
      <span class="stat-number" id="stat-lyrics">0</span>
      <span class="stat-label">lyric sheets shared</span>
    </div>
  </section>
  <script>
    import { initLandingStats } from "../lib/landing-stats";
    import { initHeroCarousel } from "../lib/hero-carousel";
    initLandingStats();
    initHeroCarousel();
  </script>
</Layout>
