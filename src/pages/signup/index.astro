---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Sign up" description="Create a WaveForge account.">
  <div class="card" style="max-width:26rem; margin:2rem auto;">
    <h1 style="margin-top:0;">Create an account</h1>
    <form id="signup-form" novalidate>
      <div class="field">
        <label for="displayName">Display name</label>
        <input id="displayName" name="displayName" type="text" autocomplete="name" required maxlength="60" />
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="new-password" required minlength="8" />
      </div>
      <p id="signup-error" class="error-text" role="alert"></p>
      <button type="submit" class="btn">Sign up</button>
    </form>
    <p class="muted" style="margin-top:1rem;">Already have an account? <a href="/login/">Log in</a></p>
  </div>
  <script>
    import { initSignupForm } from "../../lib/auth-forms";
    initSignupForm();
  </script>
</Layout>
