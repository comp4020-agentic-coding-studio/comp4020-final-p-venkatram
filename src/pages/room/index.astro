---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Room" description="A Roundsong room.">
  <div id="room-not-found" class="card" hidden>
    <h1>Room not found</h1>
    <p class="muted">Check the link, or <a href="/rooms/">go back to your rooms</a>.</p>
  </div>

  <div id="consent-root"></div>

  <div id="room-root" hidden>
    <h1 id="room-name"></h1>
    <p class="muted">Share this page's link to invite someone else in.</p>

    <div id="video-grid" class="video-grid"></div>

    <label class="field" style="flex-direction:row; align-items:center; gap:0.5rem;">
      <input type="checkbox" id="original-sound-toggle" />
      <span>Original Sound (no echo cancellation, noise suppression, or auto-gain — for singing together, not talking)</span>
    </label>

    <section class="card">
      <h2 style="margin-top:0;">Compose together</h2>
      <p class="muted">Tap a cell to add or remove a note. Everyone here sees the same grid, live.</p>
      <div id="composition-root"></div>
    </section>

    <section class="card" style="max-width:24rem;">
      <h2 style="margin-top:0;">Here now</h2>
      <ul id="presence-list" style="list-style:none; padding:0; margin:0;"></ul>
    </section>
  </div>
  <script>
    import { initRoomPage } from "../../lib/room-page";
    initRoomPage();
  </script>
</Layout>
