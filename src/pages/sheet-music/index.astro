---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Sheet Music Hub" description="Upload a MusicXML score, it renders and plays automatically.">
  <h1>Sheet Music Hub</h1>
  <p class="muted">Upload a MusicXML file and it renders here, then plays automatically. Personal to your account, nothing here is shared with anyone else.</p>
  <div id="sheet-music-root"></div>
  <script>
    import { requireSession } from "../../lib/session";
    import { initSheetMusicHub } from "../../lib/sheet-music";

    requireSession()
      .then(() => {
        const root = document.getElementById("sheet-music-root");
        if (root) initSheetMusicHub(root);
      })
      .catch(() => {
        // requireSession already redirected to /login/
      });
  </script>
</Layout>
