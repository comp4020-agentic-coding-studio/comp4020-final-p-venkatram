---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Rooms" description="Your Roundsong rooms.">
  <div id="rooms-root" hidden>
    <h1>Rooms</h1>
    <p class="muted">
      Real-time rooms — create or join one, with presence, camera consent and the shared composition space — land in
      the next commit. For now, this page just proves you're signed in.
    </p>
  </div>
  <script>
    import { requireSession } from "../../lib/session";

    requireSession()
      .then(() => {
        document.getElementById("rooms-root")?.removeAttribute("hidden");
      })
      .catch(() => {
        // requireSession already redirected to /login/
      });
  </script>
</Layout>
