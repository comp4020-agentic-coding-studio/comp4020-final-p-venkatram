---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Settings" description="WaveForge settings.">
  <h1>Settings</h1>
  <div class="card" style="max-width:26rem;">
    <h2 style="margin-top:0;">Appearance</h2>
    <p class="muted">Switch between light and dark. Saved on this device, applied the moment you choose it.</p>
    <button type="button" class="btn secondary" data-theme-toggle>Switch to dark</button>
  </div>
</Layout>
